<UserControl x:Class="ShaiyaServerHub.Controls.ScriptAreaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">
    <UserControl.Resources>
        <!-- Riga script dell'area (badge tipo colorato + nome + Esegui) -->
        <DataTemplate x:Key="AreaScriptRow">
            <Grid Margin="6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="3" Background="{Binding KindBadgeBg}"
                        Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindBrush}"
                               FontSize="9" FontWeight="Bold"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CCE0E0E0"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnEditFile}" Click="BtnEditAreaScript_Click"
                        ToolTip="{DynamicResource TipEditFile}"/>
                <Button Grid.Column="3" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnRun}" Click="BtnRunAreaScript_Click"/>
                <!-- Badge esito cliccabile: apre il log di questo singolo script -->
                <Button Grid.Column="4" MinWidth="62" Style="{StaticResource MiniButton}"
                        Content="{Binding RunStatusLabel}"
                        Background="{Binding RunStatusBg}"
                        BorderBrush="{Binding RunStatusFg}"
                        Foreground="{Binding RunStatusFg}"
                        FontWeight="Bold" Click="BtnScriptStatus_Click"
                        ToolTip="{DynamicResource TipScriptLog}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- azioni (host) -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- lista script -->
            <RowDefinition Height="150"/>    <!-- log embedded -->
        </Grid.RowDefinitions>

        <!-- Azioni specifiche iniettate dall'host (ContentPresenter) -->
        <ContentPresenter Grid.Row="0"
                          Content="{Binding Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- Toolbar comune -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="{DynamicResource BtnReloadScripts}" Click="BtnReload_Click"/>
            <Button Content="{DynamicResource BtnOpenFolders}" Click="BtnOpenFolders_Click"/>
            <Button Content="{DynamicResource BtnNewFile}" Click="BtnNewAreaFile_Click"
                    ToolTip="{DynamicResource TipNewFile}"/>
            <Button Content="{DynamicResource BtnOpenLog}" Click="BtnOpenLog_Click"/>
            <TextBlock x:Name="TbHint" Foreground="#35E8C881" FontSize="10"
                       VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Lista script dell'area -->
        <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                BorderBrush="#18E8C881" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ScriptsList" ItemTemplate="{StaticResource AreaScriptRow}"/>
            </ScrollViewer>
        </Border>

        <!-- Log embedded dell'area -->
        <Border Grid.Row="3" Margin="0,8,0,0" CornerRadius="4" Background="#06060A"
                BorderBrush="#18E8C881" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#0F0F14">
                    <TextBlock Text="{DynamicResource AreaLogTitle}" Foreground="#7BE8C881"
                               FontSize="9" FontWeight="Bold" Margin="8,3" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MiniButton}"
                            Content="{DynamicResource BtnClearLog}" Click="BtnClearLog_Click" Margin="2"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="TbAreaLog" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                         Background="#06060A" Foreground="#AADDE0E0" BorderThickness="0" Padding="6,4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
