<UserControl x:Class="ShaiyaServerHub.Controls.KeyRotationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- stato pianificazione + toolbar -->
            <RowDefinition Height="Auto"/>   <!-- banner riavvio -->
            <RowDefinition Height="Auto"/>   <!-- fingerprint chiavi -->
            <RowDefinition Height="*"/>      <!-- log -->
        </Grid.RowDefinitions>

        <!-- ── Stato rotazione pianificata + azioni ── -->
        <Border Grid.Row="0" CornerRadius="4" Background="#080810" BorderBrush="#18E8C881" BorderThickness="1" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Riga stato -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="SchedDot" Width="12" Height="12" Fill="#888" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbSchedState" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#DDE0E0E0" FontWeight="SemiBold" Text="…"/>
                    <TextBlock x:Name="TbSchedNext" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="#88E0E0E0" FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Riga pulsanti -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnRotateNow" Style="{StaticResource AccentButton}"
                            Content="{DynamicResource KrBtnRotateNow}" Click="BtnRotateNow_Click"/>
                    <Button Content="{DynamicResource KrBtnEdit}" Click="BtnEdit_Click"/>
                    <Border Width="1" Background="#28E8C881" Margin="6,3"/>
                    <Button x:Name="BtnInstallTask" Content="{DynamicResource KrBtnInstall}" Click="BtnInstallTask_Click"/>
                    <Button x:Name="BtnEnableTask" Content="{DynamicResource KrBtnEnable}" Click="BtnEnableTask_Click"/>
                    <Button x:Name="BtnDisableTask" Content="{DynamicResource KrBtnDisable}" Click="BtnDisableTask_Click"/>
                    <Border Width="1" Background="#28E8C881" Margin="6,3"/>
                    <Button Content="{DynamicResource BtnOpenLog}" Click="BtnOpenLog_Click"/>
                    <Button Content="{DynamicResource KrBtnOpenData}" Click="BtnOpenData_Click"/>
                    <Button Content="{DynamicResource PsmRefresh}" Click="BtnReload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Banner: riavvio richiesto ── -->
        <Border Grid.Row="1" x:Name="RebootBanner" Visibility="Collapsed" Margin="0,6,0,0"
                CornerRadius="4" Background="#1AE8B040" BorderBrush="#55E8B040" BorderThickness="1" Padding="10,6">
            <TextBlock x:Name="TbRebootBanner" Foreground="#E8C881" FontSize="11" TextWrapping="Wrap"
                       Text="{DynamicResource KrRebootWarn}"/>
        </Border>

        <!-- ── Chiavi correnti (fingerprint, mai in chiaro) ── -->
        <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="4" Background="#080810" BorderBrush="#18E8C881" BorderThickness="1" Padding="10,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource KrKeysTitle}" Foreground="#7BE8C881"
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TbKeyClient" FontFamily="Consolas" FontSize="11" Foreground="#AADDE0E0" Margin="0,1"/>
                <TextBlock x:Name="TbKeyToken"  FontFamily="Consolas" FontSize="11" Foreground="#AADDE0E0" Margin="0,1"/>
                <TextBlock x:Name="TbKeyPatch"  FontFamily="Consolas" FontSize="11" Foreground="#AADDE0E0" Margin="0,1"/>
                <TextBlock x:Name="TbKeySah"    FontFamily="Consolas" FontSize="11" Foreground="#77DDE0E0" Margin="0,1"/>
                <TextBlock x:Name="TbKeyMeta" FontSize="10" Foreground="#66E0E0E0" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Log ── -->
        <Border Grid.Row="3" Margin="0,8,0,0" CornerRadius="4" Background="#06060A" BorderBrush="#18E8C881" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#0F0F14">
                    <TextBlock Text="{DynamicResource AreaLogTitle}" Foreground="#7BE8C881"
                               FontSize="9" FontWeight="Bold" Margin="8,3" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MiniButton}"
                            Content="{DynamicResource BtnClearLog}" Click="BtnClearLog_Click" Margin="2"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="TbLog" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                         Background="#06060A" Foreground="#AADDE0E0" BorderThickness="0" Padding="6,4"
                         MinHeight="150"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
