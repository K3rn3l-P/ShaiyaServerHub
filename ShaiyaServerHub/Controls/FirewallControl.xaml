<UserControl x:Class="ShaiyaServerHub.Controls.FirewallControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- stato firewall -->
            <RowDefinition Height="Auto"/>   <!-- banner simplewall -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- griglia regole -->
            <RowDefinition Height="120"/>    <!-- log -->
        </Grid.RowDefinitions>

        <!-- ── Stato profili ── -->
        <Border Grid.Row="0" CornerRadius="4" Background="#080810" BorderBrush="#18E8C881" BorderThickness="1" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Riga stato -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#888" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbFwState" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#DDE0E0E0" FontWeight="SemiBold" Text="Firewall: …"/>
                    <TextBlock x:Name="TbProfiles" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="#88E0E0E0" FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Riga pulsanti (sotto, così non coprono lo stato) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnToggleFw" Style="{StaticResource AccentButton}"
                            Content="{DynamicResource FwEnableAll}" Click="BtnToggleFw_Click"/>
                    <Button Content="{DynamicResource FwOpenWf}" Click="BtnOpenWf_Click"/>
                    <Button Content="{DynamicResource PsmRefresh}" Click="BtnReload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Banner simplewall ── -->
        <Border Grid.Row="1" x:Name="SwBanner" Visibility="Collapsed" Margin="0,6,0,0"
                CornerRadius="4" Background="#1AE8C881" BorderBrush="#55E8C881" BorderThickness="1" Padding="10,6">
            <TextBlock x:Name="TbSwBanner" Foreground="#E8C881" FontSize="11" TextWrapping="Wrap"
                       Text="{DynamicResource FwSimplewallWarn}"/>
        </Border>

        <!-- ── Toolbar ── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource FwLanCidr}" Foreground="#88E0E0E0" VerticalAlignment="Center" Margin="2,0,4,0"/>
            <TextBox x:Name="TbLanCidr" Width="140" VerticalAlignment="Center"/>
            <Button Style="{StaticResource AccentButton}" Content="{DynamicResource FwApplyPosture}" Click="BtnApplyPosture_Click"/>
            <Button Content="{DynamicResource FwAddRule}" Click="BtnAddRule_Click"/>
            <Button Content="{DynamicResource FwNetTest}" Click="BtnNetTest_Click"/>
            <Button Content="{DynamicResource BtnOpenLog}" Click="BtnOpenAuditLog_Click"/>
            <Button Content="{DynamicResource FwOpenScript}" Click="BtnOpenScript_Click"/>
        </StackPanel>

        <!-- ── Regole ── -->
        <Border Grid.Row="3" Margin="0,8,0,0" CornerRadius="4" Background="#080810" BorderBrush="#18E8C881" BorderThickness="1">
            <DataGrid x:Name="GridRules" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <!-- Pallino esito ultimo Test di rete -->
                    <DataGridTemplateColumn Header="{DynamicResource FwColHealth}" Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         ToolTip="{Binding HealthTip}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Health}" Value="OK">
                                                    <Setter Property="Fill" Value="#6BD98A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Health}" Value="WARN">
                                                    <Setter Property="Fill" Value="#E8C881"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Health}" Value="RISK">
                                                    <Setter Property="Fill" Value="#F46A6A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource FwColEnabled}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Click="RuleEnabled_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource FwColRule}" Binding="{Binding DisplayName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource FwColProto}" Binding="{Binding Protocol}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource FwColPort}" Binding="{Binding LocalPort}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource FwColScope}" Binding="{Binding ScopeLabel}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource FwColAction}" Binding="{Binding Action}" Width="70" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MiniButton}" Content="✎" Padding="10,2"
                                            Click="RuleEdit_Click" ToolTip="{DynamicResource FwTipEdit}"/>
                                    <Button Style="{StaticResource DangerButton}" Content="✕" Padding="10,2"
                                            Click="RuleRemove_Click"
                                            Visibility="{Binding IsManaged, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Log ── -->
        <Border Grid.Row="4" Margin="0,8,0,0" CornerRadius="4" Background="#06060A" BorderBrush="#18E8C881" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#0F0F14">
                    <TextBlock Text="{DynamicResource AreaLogTitle}" Foreground="#7BE8C881"
                               FontSize="9" FontWeight="Bold" Margin="8,3" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MiniButton}"
                            Content="{DynamicResource BtnClearLog}" Click="BtnClearLog_Click" Margin="2"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="TbLog" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                         Background="#06060A" Foreground="#AADDE0E0" BorderThickness="0" Padding="6,4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
