<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── GroupBox ─────────────────────────────────────────── -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Padding" Value="10,8,10,10"/>
        <Setter Property="BorderBrush" Value="#4DE8C881"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#E8C881"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" CornerRadius="6"
                                Background="#0F0F14"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border Grid.Row="0" Margin="12,-6,0,0"
                                Background="#070709" Padding="5,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.Foreground="#E8C881"
                                              TextBlock.FontSize="9"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.FontFamily="Segoe UI"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Button ───────────────────────────────────────────── -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="#10E8C881"/>
        <Setter Property="BorderBrush" Value="#4DE8C881"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#DDE8C881"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#25E8C881"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7BE8C881"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38E8C881"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#08E8C881"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#18E8C881"/>
                            <Setter Property="Foreground" Value="#30E8C881"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small button variant for row actions -->
    <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <!-- Accent button (primary action) -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#18E8C881"/>
        <Setter Property="BorderBrush" Value="#7BE8C881"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Danger button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#18F46A6A"/>
        <Setter Property="BorderBrush" Value="#55F46A6A"/>
        <Setter Property="Foreground" Value="#DDF4A6A6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- ── TextBox ──────────────────────────────────────────── -->
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Background" Value="#080810"/>
        <Setter Property="BorderBrush" Value="#28E8C881"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#DDE0E0E0"/>
        <Setter Property="CaretBrush" Value="#E8C881"/>
        <Setter Property="SelectionBrush" Value="#35E8C881"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7BE8C881"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#080810"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#12E8C881"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#040408"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0AE8C881"/>
                            <Setter Property="Foreground" Value="#30E0E0E0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── PasswordBox ──────────────────────────────────────── -->
    <Style TargetType="PasswordBox">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Background" Value="#080810"/>
        <Setter Property="BorderBrush" Value="#28E8C881"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#DDE0E0E0"/>
        <Setter Property="CaretBrush" Value="#E8C881"/>
        <Setter Property="SelectionBrush" Value="#35E8C881"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7BE8C881"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Label ────────────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="#88E0E0E0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ── CheckBox ─────────────────────────────────────────── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#99E0E0E0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="Border" Width="13" Height="13" CornerRadius="2"
                                    Background="Transparent" BorderThickness="1" BorderBrush="#4DE8C881">
                                <Path x:Name="CheckMark" SnapsToDevicePixels="False"
                                      Stroke="#E8C881" StrokeThickness="1.5"
                                      Data="M 0,0 L 9,9 M 0,9 L 9,0"
                                      Width="9" Height="9"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#7BE8C881"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── RadioButton ──────────────────────────────────────── -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#99E0E0E0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="13" Height="13">
                                <Ellipse Stroke="#4DE8C881" StrokeThickness="1" Fill="Transparent"/>
                                <Ellipse x:Name="Dot" Margin="3" Fill="#E8C881"/>
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBox (dark) ──────────────────────────────────── -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" CornerRadius="4" Background="#080810"
                BorderBrush="#28E8C881" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#88E8C881"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#7BE8C881"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Foreground" Value="#DDE0E0E0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False"
                                      Template="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="8,0,22,0" VerticalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="#0F0F14" BorderBrush="#4DE8C881" BorderThickness="1"
                                    CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="220">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#CCE0E0E0"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#20E8C881"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Nav item (sidebar) ───────────────────────────────── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#99E0E0E0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="12,10" Margin="0,2">
                        <Grid>
                            <Rectangle x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left"
                                       Fill="#E8C881" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#10E8C881"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1EE8C881"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="#E8C881"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TabControl / TabItem (schede gold, vista Funzioni) ──── -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Barra schede -->
                        <Border Grid.Row="0" BorderBrush="#28E8C881" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0,0,0,-1" Panel.ZIndex="1"/>
                        </Border>
                        <!-- Contenuto scheda selezionata -->
                        <Border Grid.Row="1" Margin="0,8,0,0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#88E0E0E0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" CornerRadius="5,5,0,0" Margin="0,0,3,0"
                            Background="#0AE8C881" BorderBrush="#20E8C881"
                            BorderThickness="1,1,1,0" Padding="14,7">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18E8C881"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4DE8C881"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1EE8C881"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7BE8C881"/>
                            <Setter Property="Foreground" Value="#E8C881"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Scrollbar sottile gold ────────────────────────────── -->
    <ControlTemplate x:Key="GoldScrollThumb" TargetType="Thumb">
        <Border x:Name="Bd" CornerRadius="3" Background="#50E8C881" Margin="1"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B0E8C881"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8C881"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="GoldScrollBtn" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>

    <!-- Template verticale -->
    <ControlTemplate x:Key="GoldScrollV" TargetType="ScrollBar">
        <Border CornerRadius="4" Background="#0AE8C881">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Template="{StaticResource GoldScrollBtn}" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Template="{StaticResource GoldScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Template="{StaticResource GoldScrollBtn}" Focusable="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <!-- Template orizzontale -->
    <ControlTemplate x:Key="GoldScrollH" TargetType="ScrollBar">
        <Border CornerRadius="4" Background="#0AE8C881">
            <Track x:Name="PART_Track" Orientation="Horizontal" Margin="2,0">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Template="{StaticResource GoldScrollBtn}" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Template="{StaticResource GoldScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Template="{StaticResource GoldScrollBtn}" Focusable="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <!-- ── DataGrid (dark gold, compatta) ───────────────────── -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#0F0F14"/>
        <Setter Property="Foreground" Value="#E8C881"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="#20E8C881"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CCE0E0E0"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#06E8C881"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1EE8C881"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#CCE0E0E0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderThickness="0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F0E8C881"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#080810"/>
        <Setter Property="BorderBrush" Value="#18E8C881"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#12E8C881"/>
        <Setter Property="VerticalGridLinesBrush" Value="#0CE8C881"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="ColumnHeaderHeight" Value="28"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#CCE0E0E0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Stile GLOBALE implicito: si applica a tutte le ScrollBar dell'app -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Template" Value="{StaticResource GoldScrollV}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="9"/>
                <Setter Property="Template" Value="{StaticResource GoldScrollH}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
