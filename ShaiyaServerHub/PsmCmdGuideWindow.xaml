<Window x:Class="ShaiyaServerHub.PsmCmdGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guida PSM_Cmd" Icon="icon.ico"
        Width="720" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Window.Resources>
        <!-- Titolo sezione -->
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8C881"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <!-- Paragrafo -->
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BBD0D0D0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <!-- Badge tier -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragWindow" HorizontalAlignment="Left">
                    <TextBlock Text="❓" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource PsmGHdr}" Foreground="#E8C881"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" CornerRadius="4" Background="#06060A" BorderBrush="#18E8C881" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel>

                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGIntro}"/>

                        <TextBlock Style="{StaticResource H}" Text="{DynamicResource PsmGFlowH}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGFlowP}"/>
                        <TextBlock Style="{StaticResource P}" FontFamily="Consolas" Foreground="#88E8C881"
                            Text="caller → usp_RunCommand / usp_SendNotice → dbo.Command → ps_game/ps_login"/>

                        <TextBlock Style="{StaticResource H}" Text="{DynamicResource PsmGTierH}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGTierIntro}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <Border Style="{StaticResource Badge}" Background="#1E6BD98A"><TextBlock Text="SAFE" Foreground="#6BD98A" FontSize="10" FontWeight="Bold"/></Border>
                            <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGTierSafe}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Style="{StaticResource Badge}" Background="#1E7FB0E8"><TextBlock Text="PLAYER" Foreground="#7FB0E8" FontSize="10" FontWeight="Bold"/></Border>
                            <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGTierPlayer}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Style="{StaticResource Badge}" Background="#1EE8C881"><TextBlock Text="ECONOMY" Foreground="#E8C881" FontSize="10" FontWeight="Bold"/></Border>
                            <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGTierEconomy}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Style="{StaticResource Badge}" Background="#1EF46A6A"><TextBlock Text="SERVICE" Foreground="#F46A6A" FontSize="10" FontWeight="Bold"/></Border>
                            <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGTierService}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource H}" Text="{DynamicResource PsmGAllowH}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGAllowP}"/>

                        <TextBlock Style="{StaticResource H}" Text="{DynamicResource PsmGCallersH}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGCallersP}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGCallersP2}"/>

                        <TextBlock Style="{StaticResource H}" Text="{DynamicResource PsmGLogH}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGLogP}"/>

                        <TextBlock Style="{StaticResource H}" Text="{DynamicResource PsmGPracticeH}"/>
                        <TextBlock Style="{StaticResource P}" Text="{DynamicResource PsmGPracticeP}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource PsmGGotIt}" Click="BtnClose_Click" MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
