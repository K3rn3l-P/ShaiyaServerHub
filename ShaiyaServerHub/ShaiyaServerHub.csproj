<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShaiyaServerHub</RootNamespace>
    <AssemblyName>ShaiyaServerHub</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Company>K3rn3l</Company>
    <Product>ShaiyaServerHub</Product>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>ShaiyaServerHub — by K3rn3l</AssemblyTitle>
    <!-- Cartella output = bin\<Config>\ShaiyaServerHub (non net48) → pronta da copiare sul server. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\ShaiyaServerHub\</OutputPath>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference di framework (nessuna DLL esterna). -->
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Security" />
    <!-- ADO.NET (System.Data.SqlClient) per gli editor PSM_Cmd: query parametrizzate. -->
    <Reference Include="System.Data" />
    <!-- Client HTTP verso OpenRouter/Telegram/SearXNG (modulo AI). Solo lato server, mai nel client di gioco. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unico pacchetto NuGet del progetto: JSON per il modulo AI (chat/tool-calling OpenRouter,
         Telegram Bot API, SearXNG). Microsoft-first party, nessuna dipendenza transitiva. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- La copia dei DefaultScripts nell'output è gestita da Build-And-Copy.ps1
       (build + copia + inject .env in un unico script), non da un target MSBuild. -->

</Project>
