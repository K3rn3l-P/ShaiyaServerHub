<Window x:Class="ShaiyaServerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShaiyaServerHub.Controls"
        Title="ShaiyaServerHub" Icon="icon.ico"
        Width="1180" Height="800" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Window.Resources>
        <!-- Riga script condivisa (badge tipo colorato + nome + azioni) -->
        <DataTemplate x:Key="ScriptRow">
            <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="3" Background="{Binding KindBadgeBg}"
                        Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindBrush}"
                               FontSize="9" FontWeight="Bold"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CCE0E0E0"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnEditFile}" Click="BtnEditScript_Click"
                        ToolTip="{DynamicResource TipEditFile}"/>
                <Button Grid.Column="3" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnRun}" Click="BtnRunScript_Click"/>
                <Button Grid.Column="4" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnSchedule}" Click="BtnScheduleScript_Click"/>
            </Grid>
        </DataTemplate>

        <!-- ── Dashboard: tessera KPI cliccabile ──────────────── -->
        <Style x:Key="DashTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#0F0F16"/>
            <Setter Property="BorderBrush" Value="#22E8C881"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161620"/>
                    <Setter Property="BorderBrush" Value="#7BE8C881"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Dashboard: card contenitiva (non cliccabile) ────── -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#0C0C13"/>
            <Setter Property="BorderBrush" Value="#1CE8C881"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ── Dashboard: riga servizio compatta (pallino + nome + stato) ── -->
        <DataTemplate x:Key="DashServiceRow">
            <Grid Margin="10,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#C8E0E0E0"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#E8C881" BlurRadius="24" ShadowDepth="0" Opacity="0.13"/>
        </Border.Effect>

        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────── -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="16,10"
                    CornerRadius="6" BorderThickness="1" BorderBrush="#2DE8C881" Background="#0F0F14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    MouseLeftButtonDown="DragWindow">
                            <TextBlock Text="SHAIYA SERVER HUB" Foreground="#E8C881"
                                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Rectangle Width="1" Height="14" Fill="#2DE8C881" Margin="12,0"/>
                            <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="#50E8C881"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  by K3rn3l" Foreground="#28E8C881"
                                       FontSize="10" VerticalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="BtnSettings" CornerRadius="3" Padding="9,3" Cursor="Hand"
                                    BorderThickness="1" Background="Transparent"
                                    MouseLeftButtonUp="BtnSettings_Click"
                                    MouseEnter="BtnChromeBtn_MouseEnter" MouseLeave="BtnChromeBtn_MouseLeave">
                                <Border.BorderBrush><SolidColorBrush Color="#20E8C881"/></Border.BorderBrush>
                                <TextBlock Text="⚙" FontSize="13" Foreground="#60E8C881"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                            <Rectangle Width="1" Height="14" Fill="#15E8C881" Margin="8,0"/>
                            <Border x:Name="BtnLangIt" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                    BorderThickness="1" MouseLeftButtonUp="BtnLangIt_Click">
                                <TextBlock x:Name="TbLangIt" Text="IT" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text=" │ " Foreground="#20E8C881" VerticalAlignment="Center" FontSize="10" Margin="1,0"/>
                            <Border x:Name="BtnLangEn" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                    BorderThickness="1" MouseLeftButtonUp="BtnLangEn_Click">
                                <TextBlock x:Name="TbLangEn" Text="EN" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Rectangle Width="1" Height="14" Fill="#15E8C881" Margin="8,0"/>
                            <Border x:Name="BtnMin" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                    Background="Transparent" MouseLeftButtonUp="BtnMin_Click"
                                    MouseEnter="BtnChromeBtn_MouseEnter" MouseLeave="BtnChromeBtn_MouseLeave">
                                <TextBlock Text="─" FontSize="11" Foreground="#60E8C881"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                            <Border x:Name="BtnClose" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                    Background="Transparent" MouseLeftButtonUp="BtnClose_Click"
                                    MouseEnter="BtnCloseChromeBtn_MouseEnter" MouseLeave="BtnChromeBtn_MouseLeave">
                                <TextBlock Text="✕" FontSize="11" Foreground="#60E8C881"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Barra di stato persistente (visibile in OGNI vista): banner manutenzione
                         (solo se attiva) + player online admin/normal (sempre) + salute sistema
                         complessiva servizi/firewall/web (sempre). Aggiornata da HeaderStatusTick
                         ogni 15s, indipendente dalla vista aperta — vedi MainWindow.xaml.cs. -->
                    <Border x:Name="HeaderStatusBar" Grid.Row="1" Margin="0,8,0,0" Padding="10,6"
                            CornerRadius="4" Background="#141420" BorderThickness="1" BorderBrush="#1CE8C881">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="HeaderMntBanner" CornerRadius="3" Padding="8,3" Margin="0,0,10,0"
                                        Background="#7A1414" Visibility="Collapsed">
                                    <TextBlock x:Name="TbHeaderMnt" Foreground="#FFD8D8" FontSize="11"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TbHeaderPlayers" Foreground="#CFE0E0E0" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="HeaderSysDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#66707A"/>
                                <TextBlock x:Name="TbHeaderSys" Margin="6,0,0,0" Foreground="#CFE0E0E0"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Grip di ridimensionamento (angolo basso-destra) ─── -->
            <Thumb x:Name="ResizeGrip" Grid.Row="1" Width="18" Height="18"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,-4,-6" Panel.ZIndex="100" Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta"
                   ToolTip="{DynamicResource TipResize}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="#01000000">
                            <Path x:Name="Grip" Stroke="#4DE8C881" StrokeThickness="1.3"
                                  SnapsToDevicePixels="True"
                                  Data="M14,4 L4,14 M14,8 L8,14 M14,12 L12,14"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Stroke" Value="#C8E8C881"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Stroke" Value="#E8C881"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- ── Body: nav sinistra + contenuto ─────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nav -->
                <Border Grid.Column="0" CornerRadius="6" Background="#0C0C11"
                        BorderBrush="#20E8C881" BorderThickness="1" Padding="8,10" Margin="0,0,8,0">
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="dashboard" Content="{DynamicResource NavDashboard}" Checked="Nav_Checked" IsChecked="True"/>
                        <Rectangle Height="1" Fill="#14E8C881" Margin="8,4,8,6"/>
                        <RadioButton x:Name="NavScripts"  Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="scripts"  Content="{DynamicResource NavScripts}"  Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNewTask"  Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="newtask"  Content="{DynamicResource NavNewTask}"  Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTasks"    Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="tasks"    Content="{DynamicResource NavTasks}"    Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavServices" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="services" Content="{DynamicResource NavServices}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWeb" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="web" Content="{DynamicResource NavWeb}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFunctions" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="functions" Content="{DynamicResource NavFunctions}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTestSuite" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="testsuite" Content="{DynamicResource NavTestSuite}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavKeyRotation" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="keyrotation" Content="{DynamicResource NavKeyRotation}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAi" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="ai" Content="{DynamicResource NavAi}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLog"      Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="log"      Content="{DynamicResource NavLog}"      Checked="Nav_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Contenuto: una vista visibile alla volta -->
                <Grid Grid.Column="1">

                    <!-- ══ Dashboard (vista di default): panoramica a colpo d'occhio ══ -->
                    <GroupBox x:Name="PanelDashboard" Header="{DynamicResource GbDashboard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Barra superiore: titolo · server · ultimo aggiornamento · refresh -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource DashOverview}" Foreground="#E8C881"
                                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Rectangle Width="1" Height="13" Fill="#2DE8C881" Margin="12,0"/>
                                    <TextBlock x:Name="TbDashHost" Foreground="#70E8C881" FontFamily="Consolas"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TbDashUpdated" Foreground="#48E0E0E0" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource BtnDashRefresh}" Click="BtnDashRefresh_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Riga KPI: 4 tessere cliccabili -->
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,4">
                                <!-- Servizi -->
                                <Border Style="{StaticResource DashTile}" Margin="0,0,5,0"
                                        Tag="services" MouseLeftButtonUp="DashTile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DashKpiServices}" Foreground="#60E8C881"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TbKpiSvc" Text="–" Foreground="#E8C881"
                                                   FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TbKpiSvcSub" Text="" FontSize="10"
                                                   Foreground="#88E0E0E0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <!-- Task -->
                                <Border Style="{StaticResource DashTile}" Margin="5,0,5,0"
                                        Tag="tasks" MouseLeftButtonUp="DashTile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DashKpiTasks}" Foreground="#60E8C881"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TbKpiTasks" Text="–" Foreground="#E8C881"
                                                   FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
                                        <!-- Esiti ultimo run: ● verde = OK · ● rosso = errore -->
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="#4DC870"/>
                                            <TextBlock x:Name="TbKpiTasksOk" Text="0" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#A8E0E0E0" Margin="3,0,10,0" VerticalAlignment="Center"/>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="#F46A6A"/>
                                            <TextBlock x:Name="TbKpiTasksErr" Text="0" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#A8E0E0E0" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Script -->
                                <Border Style="{StaticResource DashTile}" Margin="5,0,5,0"
                                        Tag="scripts" MouseLeftButtonUp="DashTile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DashKpiScripts}" Foreground="#60E8C881"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TbKpiScripts" Text="–" Foreground="#E8C881"
                                                   FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TbKpiScriptsSub" Text="" FontSize="10"
                                                   Foreground="#88E0E0E0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <!-- Web -->
                                <Border Style="{StaticResource DashTile}" Margin="5,0,0,0"
                                        Tag="web" MouseLeftButtonUp="DashTile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DashKpiWeb}" Foreground="#60E8C881"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TbKpiWeb" Text="…" Foreground="#E8C881"
                                                   FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="TbKpiWebSub" Text="" FontSize="10"
                                                   Foreground="#88E0E0E0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Corpo: colonna sinistra (servizi) + destra (web / firewall) -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="384"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card servizi di gioco -->
                                <Border Grid.Column="0" Style="{StaticResource DashCard}" Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#0EE8C881" CornerRadius="7,7,0,0" Padding="12,7">
                                            <TextBlock Text="{DynamicResource DashCardServices}" Foreground="#B8E8C881"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4">
                                            <ItemsControl x:Name="DashServicesList" ItemTemplate="{StaticResource DashServiceRow}"/>
                                        </ScrollViewer>
                                        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="8,4,8,8"
                                                Style="{StaticResource MiniButton}"
                                                Content="{DynamicResource DashOpenServices}"
                                                Tag="services" Click="DashOpen_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Colonna destra: griglia 2×2 (Manutenzione · Firewall · PSM_Cmd · Test Suite) -->
                                <Grid Grid.Column="1" Margin="5,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Manutenzione (0,0): sostituisce la ex Card Web server (doppione
                                         con la tessera KPI "Web" in alto). Stato normale/attiva + toggle. -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#0EF46A6A" CornerRadius="7,7,0,0" Padding="12,7">
                                                <TextBlock Text="{DynamicResource DashCardMaintenance}" Foreground="#F0A8A8"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="12,8" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DashMntDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#66707A"/>
                                                    <TextBlock x:Name="TbDashMntState" Margin="6,0,0,0" Foreground="#E8C881"
                                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TbDashMntPlayers" Margin="0,4,0,0" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="#CFE0E0E0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TbDashMntSub" Margin="0,3,0,0" FontSize="10"
                                                           Foreground="#88E0E0E0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,8,8">
                                                <Button x:Name="BtnMaintenanceRekick" Margin="0,0,6,0"
                                                        Style="{StaticResource MiniButton}"
                                                        Content="{DynamicResource MntBtnRekick}"
                                                        Click="BtnMaintenanceRekick_Click"/>
                                                <Button x:Name="BtnMaintenanceToggle"
                                                        Style="{StaticResource MiniButton}"
                                                        Click="BtnMaintenanceToggle_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Card Sicurezza / Firewall (0,1) -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#0E52A8FF" CornerRadius="7,7,0,0" Padding="12,7">
                                                <TextBlock Text="{DynamicResource DashCardFirewall}" Foreground="#8FC2FF"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="12,8" VerticalAlignment="Center">
                                                <TextBlock x:Name="TbDashFwState" Foreground="#E8C881" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TbDashFwSub" Margin="0,4,0,0" FontSize="10"
                                                           Foreground="#88E0E0E0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Row="2" HorizontalAlignment="Right" Margin="8,0,8,8"
                                                    Style="{StaticResource MiniButton}"
                                                    Content="{DynamicResource DashOpenFirewall}"
                                                    Tag="functions" Click="DashOpen_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card PSM_Cmd (1,0) -->
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DashCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#0EE8C881" CornerRadius="7,7,0,0" Padding="12,7">
                                                <TextBlock Text="{DynamicResource DashCardPsm}" Foreground="#B8E8C881"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="12,8" VerticalAlignment="Center">
                                                <TextBlock x:Name="TbDashPsmState" Foreground="#E8C881" FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TbDashPsmSub" Margin="0,4,0,0" FontSize="10"
                                                           Foreground="#88E0E0E0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Row="2" HorizontalAlignment="Right" Margin="8,0,8,8"
                                                    Style="{StaticResource MiniButton}"
                                                    Content="{DynamicResource DashOpenPsm}"
                                                    Tag="functions" Click="DashOpen_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card Test Suite (1,1): esiti ultimo run · ● PASS/WARN/FAIL -->
                                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DashCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#0EB07BE8" CornerRadius="7,7,0,0" Padding="12,7">
                                                <TextBlock Text="{DynamicResource DashCardTestSuite}" Foreground="#C6A8F0"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="12,8" VerticalAlignment="Center">
                                                <TextBlock x:Name="TbDashTsSummary" Foreground="#9BE0E0E0" FontSize="11"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#4DC870"/>
                                                    <TextBlock x:Name="TbDashTsPass" Text="–" FontSize="13" FontWeight="Bold"
                                                               Foreground="#CFE0E0E0" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#E8B040"/>
                                                    <TextBlock x:Name="TbDashTsWarn" Text="–" FontSize="13" FontWeight="Bold"
                                                               Foreground="#CFE0E0E0" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#F46A6A"/>
                                                    <TextBlock x:Name="TbDashTsFail" Text="–" FontSize="13" FontWeight="Bold"
                                                               Foreground="#CFE0E0E0" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Row="2" HorizontalAlignment="Right" Margin="8,0,8,8"
                                                    Style="{StaticResource MiniButton}"
                                                    Content="{DynamicResource DashOpenTestSuite}"
                                                    Tag="testsuite" Click="DashOpen_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card Key Rotation (riga 4, full-width): ultima rotazione · prossimo run · esito -->
                                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DashCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0EE8C881" CornerRadius="7,0,0,7" Padding="12,7"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="{DynamicResource DashCardKeyRotation}" Foreground="#B8E8C881"
                                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,7" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DashKrDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#66707A"/>
                                                    <TextBlock x:Name="TbDashKrState" Margin="6,0,0,0" Foreground="#E8C881"
                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TbDashKrSub" Margin="0,3,0,0" FontSize="10"
                                                           Foreground="#88E0E0E0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0"
                                                    Style="{StaticResource MiniButton}"
                                                    Content="{DynamicResource DashOpenKeyRotation}"
                                                    Tag="keyrotation" Click="DashOpen_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card AI (riga 6, full-width): verdetto ●verde/giallo/rosso + ultimo alert -->
                                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DashCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0EB07BE8" CornerRadius="7,0,0,7" Padding="12,7"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="{DynamicResource DashCardAi}" Foreground="#C6A8F0"
                                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,7" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DashAiDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#66707A"/>
                                                    <TextBlock x:Name="TbDashAiState" Margin="6,0,0,0" Foreground="#E8C881"
                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TbDashAiSub" Margin="0,3,0,0" FontSize="10"
                                                           Foreground="#88E0E0E0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0"
                                                    Style="{StaticResource MiniButton}"
                                                    Content="{DynamicResource DashOpenAi}"
                                                    Tag="ai" Click="DashOpen_Click"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Azioni rapide -->
                            <Border Grid.Row="3" Style="{StaticResource DashCard}" Margin="0,10,0,0" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource DashQuickActions}" Foreground="#60E8C881"
                                               FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource AccentButton}"
                                                Content="{DynamicResource BtnStartServices}" Click="BtnStartServices_Click"/>
                                        <Button Content="{DynamicResource DashActNewTask}" Tag="newtask" Click="DashOpen_Click"/>
                                        <Button Content="{DynamicResource DashActTestSuite}" Tag="testsuite" Click="DashOpen_Click"/>
                                        <Button Content="{DynamicResource DashActFunctions}" Tag="functions" Click="DashOpen_Click"/>
                                        <Button Content="{DynamicResource DashActLog}" Tag="log" Click="DashOpen_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Scripts: due sezioni distinte (SQL / PS1·BAT) -->
                    <GroupBox x:Name="PanelScripts" Header="{DynamicResource GbScripts}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnReloadScripts}" Click="BtnReloadScripts_Click"/>
                                <Button Content="{DynamicResource BtnOpenFolders}" Click="BtnOpenFolders_Click"/>
                                <Button Content="{DynamicResource BtnNewFile}" Click="BtnNewScript_Click"
                                        ToolTip="{DynamicResource TipNewFile}"/>
                                <TextBlock Text="{DynamicResource HintScripts}" Foreground="#35E8C881"
                                           FontSize="10" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- SQL -->
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#2252A8FF" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1152A8FF" CornerRadius="4,4,0,0" Padding="8,4">
                                        <TextBlock Text="{DynamicResource HdrDbSql}" Foreground="#52A8FF"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScriptsSqlList" ItemTemplate="{StaticResource ScriptRow}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- PS1 / BAT -->
                            <Border Grid.Row="3" CornerRadius="4" Background="#080810"
                                    BorderBrush="#225BD16A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#115BD16A" CornerRadius="4,4,0,0" Padding="8,4">
                                        <TextBlock Text="{DynamicResource HdrSysPs}" Foreground="#5BD16A"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScriptsPsList" ItemTemplate="{StaticResource ScriptRow}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- New task (form riutilizzabile, stesso del modale Pianifica) -->
                    <GroupBox x:Name="PanelNewTask" Header="{DynamicResource GbNewTask}" Visibility="Collapsed">
                        <controls:NewTaskControl x:Name="NewTaskCtrl"/>
                    </GroupBox>

                    <!-- Tasks -->
                    <GroupBox x:Name="PanelTasks" Header="{DynamicResource GbTasks}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnReloadTasks}" Click="BtnReloadTasks_Click"/>
                                <Button Content="{DynamicResource BtnOpenTaskSched}" Click="BtnOpenTaskSched_Click"
                                        ToolTip="{DynamicResource TipOpenTaskSched}"/>
                                <TextBlock x:Name="TbTaskStatus" VerticalAlignment="Center" Margin="12,0"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#18E8C881" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TasksList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#CCE0E0E0"
                                                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#7BE8C881"
                                                               FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Schedule}" Foreground="#66E0E0E0"
                                                               FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10"
                                                            Content="{DynamicResource BtnRunNow}" Click="BtnRunNowTask_Click"
                                                            ToolTip="{DynamicResource TipRunNowTask}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource MiniButton}" Foreground="#EEF0F0F0"
                                                            Background="{Binding LogBrush}" IsEnabled="{Binding HasLog}"
                                                            Content="{DynamicResource BtnTaskLog}" Click="BtnTaskLog_Click"
                                                            ToolTip="{Binding LogTip}"/>
                                                    <Button Grid.Column="5" Style="{StaticResource MiniButton}"
                                                            Content="{DynamicResource BtnEditTask}" Click="BtnEditTask_Click"
                                                            ToolTip="{DynamicResource TipEditTask}"/>
                                                    <Button Grid.Column="6" Style="{StaticResource MiniButton}"
                                                            Content="{DynamicResource BtnEnable}" Click="BtnEnableTask_Click"/>
                                                    <Button Grid.Column="7" Style="{StaticResource MiniButton}"
                                                            Content="{DynamicResource BtnDisable}" Click="BtnDisableTask_Click"/>
                                                    <Button Grid.Column="8" Style="{StaticResource DangerButton}"
                                                            Content="{DynamicResource BtnRemove}" Click="BtnRemoveTask_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Services -->
                    <GroupBox x:Name="PanelServices" Header="{DynamicResource GbServices}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnRefreshServices}" Click="BtnRefreshServices_Click"/>
                                <Button Content="{DynamicResource BtnStartServices}" Click="BtnStartServices_Click"/>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#18E8C881" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ServicesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#CCE0E0E0"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding StatusBrush}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10"
                                                                Content="{DynamicResource BtnStart}" Click="BtnStartService_Click"
                                                                Visibility="{Binding StartVis}"/>
                                                        <Button Style="{StaticResource DangerButton}"
                                                                Content="{DynamicResource BtnStop}" Click="BtnStopService_Click"
                                                                Visibility="{Binding StopVis}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Web server (XAMPP/Apache · IIS) -->
                    <GroupBox x:Name="PanelWeb" Header="{DynamicResource GbWeb}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0">
                                <Button Content="{DynamicResource BtnRefreshWeb}" Click="BtnRefreshWeb_Click"/>
                                <Button Content="{DynamicResource BtnRestartWeb}" Click="BtnRestartWeb_Click"/>
                                <Button Content="{DynamicResource BtnWebSslGen}" Click="BtnWebSslGen_Click"
                                        ToolTip="{DynamicResource TipWebSslGen}"/>
                                <Button Content="{DynamicResource BtnBackupWeb}" Click="BtnBackupWeb_Click"/>
                                <Button Content="{DynamicResource BtnOpenWebRoot}" Click="BtnOpenWebRoot_Click"/>
                                <Button Content="{DynamicResource BtnOpenWebLogs}" Click="BtnOpenWebLogs_Click"/>
                                <Button Style="{StaticResource AccentButton}"
                                        Content="{DynamicResource BtnWebSettings}" Click="BtnWebSettings_Click"/>
                            </WrapPanel>

                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#225BD16A" BorderThickness="1" Padding="10,7">
                                <StackPanel>
                                    <TextBlock x:Name="TbWebKind" Foreground="#7BE8C881" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TbWebHealth" Margin="0,3,0,0" FontFamily="Consolas" FontSize="11"
                                               Foreground="#AADDE0E0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TbWebCert" Margin="0,3,0,0" FontSize="10" Foreground="#66E0E0E0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#18E8C881" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="WebServicesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#CCE0E0E0"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding StatusBrush}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10"
                                                                Content="{DynamicResource BtnStart}" Click="BtnStartService_Click"
                                                                Visibility="{Binding StartVis}"/>
                                                        <Button Style="{StaticResource DangerButton}"
                                                                Content="{DynamicResource BtnStop}" Click="BtnStopService_Click"
                                                                Visibility="{Binding StopVis}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Funzioni: contenitore a schede (una scheda per funzione) -->
                    <GroupBox x:Name="PanelFunctions" Header="{DynamicResource GbFunctions}" Visibility="Collapsed">
                        <TabControl x:Name="FunctionsTabs">
                            <!-- Scheda 1: PSM_Cmd-SecureCommandChannel (functions\psm_cmd-scc) -->
                            <TabItem Header="{DynamicResource TabPsmCmd}">
                                <controls:ScriptAreaControl x:Name="FuncArea">
                                    <controls:ScriptAreaControl.Actions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource AccentButton}"
                                                    Content="{DynamicResource BtnVerifyPsm}" Click="BtnVerifyPsmCmd_Click"/>
                                            <Button Content="{DynamicResource BtnInstallPsm}" Click="BtnInstallPsmCmd_Click"/>
                                            <Border Width="1" Background="#28E8C881" Margin="6,3"/>
                                            <Button Content="{DynamicResource BtnPsmSettings}" Click="BtnPsmCmdSettings_Click"/>
                                            <Button Content="{DynamicResource BtnPsmLog}" Click="BtnPsmCmdLog_Click"/>
                                        </StackPanel>
                                    </controls:ScriptAreaControl.Actions>
                                </controls:ScriptAreaControl>
                            </TabItem>
                            <!-- Scheda 2: Windows Firewall -->
                            <TabItem Header="{DynamicResource TabFirewall}">
                                <controls:FirewallControl x:Name="FwArea"/>
                            </TabItem>
                            <!-- Nuove schede funzione: aggiungere qui un <TabItem> con la sua ScriptAreaControl. -->
                        </TabControl>
                    </GroupBox>

                    <!-- Test Suite -->
                    <GroupBox x:Name="PanelTestSuite" Header="{DynamicResource GbTestSuite}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource GbExternalTools}" Foreground="#7BE8C881"
                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TbAutorunsStatus" Foreground="#AADDE0E0" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="{DynamicResource BtnDownloadTools}" Click="BtnDownloadTools_Click"
                                        ToolTip="{DynamicResource TipDownloadTools}"/>
                            </StackPanel>
                            <controls:ScriptAreaControl x:Name="TestArea" Grid.Row="1">
                                <controls:ScriptAreaControl.Actions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButton}"
                                                Content="{DynamicResource BtnRunTestSuite}" Click="BtnRunTestSuite_Click"/>
                                        <Border Width="1" Background="#28E8C881" Margin="6,3"/>
                                        <Button Content="{DynamicResource BtnInstallSqlAudit}" Click="BtnInstallSqlAudit_Click"
                                                ToolTip="{DynamicResource TipInstallSqlAudit}"/>
                                    </StackPanel>
                                </controls:ScriptAreaControl.Actions>
                            </controls:ScriptAreaControl>
                        </Grid>
                    </GroupBox>

                    <!-- Key Rotation -->
                    <GroupBox x:Name="PanelKeyRotation" Header="{DynamicResource GbKeyRotation}" Visibility="Collapsed">
                        <controls:KeyRotationControl x:Name="KeyRotArea"/>
                    </GroupBox>

                    <!-- AI (Hub Brain) -->
                    <GroupBox x:Name="PanelAi" Header="{DynamicResource GbAi}" Visibility="Collapsed">
                        <controls:AiControl x:Name="AiArea"/>
                    </GroupBox>

                    <!-- Log -->
                    <GroupBox x:Name="PanelLog" Header="{DynamicResource GbLog}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" x:Name="TbLog" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                     Background="#06060A" Foreground="#AADDE0E0" BorderThickness="0" Padding="6,6"/>
                            <Button Grid.Row="1" Content="{DynamicResource BtnClearLog}" HorizontalAlignment="Right"
                                    Click="BtnClearLog_Click" Margin="2,4,2,0"/>
                        </Grid>
                    </GroupBox>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
