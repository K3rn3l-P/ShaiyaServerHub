<Window x:Class="ShaiyaServerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShaiyaServerHub.Controls"
        Title="ShaiyaServerHub" Icon="icon.ico"
        Width="1040" Height="660" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Window.Resources>
        <!-- Riga script condivisa (badge tipo colorato + nome + azioni) -->
        <DataTemplate x:Key="ScriptRow">
            <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="3" Background="{Binding KindBadgeBg}"
                        Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindBrush}"
                               FontSize="9" FontWeight="Bold"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CCE0E0E0"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnEditFile}" Click="BtnEditScript_Click"
                        ToolTip="{DynamicResource TipEditFile}"/>
                <Button Grid.Column="3" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnRun}" Click="BtnRunScript_Click"/>
                <Button Grid.Column="4" Style="{StaticResource MiniButton}"
                        Content="{DynamicResource BtnSchedule}" Click="BtnScheduleScript_Click"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#E8C881" BlurRadius="24" ShadowDepth="0" Opacity="0.13"/>
        </Border.Effect>

        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────── -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="16,10"
                    CornerRadius="6" BorderThickness="1" BorderBrush="#2DE8C881" Background="#0F0F14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                MouseLeftButtonDown="DragWindow">
                        <TextBlock Text="SHAIYA SERVER HUB" Foreground="#E8C881"
                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="14" Fill="#2DE8C881" Margin="12,0"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="#50E8C881"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  by K3rn3l" Foreground="#28E8C881"
                                   FontSize="10" VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="BtnSettings" CornerRadius="3" Padding="9,3" Cursor="Hand"
                                BorderThickness="1" Background="Transparent"
                                MouseLeftButtonUp="BtnSettings_Click"
                                MouseEnter="BtnChromeBtn_MouseEnter" MouseLeave="BtnChromeBtn_MouseLeave">
                            <Border.BorderBrush><SolidColorBrush Color="#20E8C881"/></Border.BorderBrush>
                            <TextBlock Text="⚙" FontSize="13" Foreground="#60E8C881"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Rectangle Width="1" Height="14" Fill="#15E8C881" Margin="8,0"/>
                        <Border x:Name="BtnLangIt" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                BorderThickness="1" MouseLeftButtonUp="BtnLangIt_Click">
                            <TextBlock x:Name="TbLangIt" Text="IT" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text=" │ " Foreground="#20E8C881" VerticalAlignment="Center" FontSize="10" Margin="1,0"/>
                        <Border x:Name="BtnLangEn" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                BorderThickness="1" MouseLeftButtonUp="BtnLangEn_Click">
                            <TextBlock x:Name="TbLangEn" Text="EN" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Rectangle Width="1" Height="14" Fill="#15E8C881" Margin="8,0"/>
                        <Border x:Name="BtnMin" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                Background="Transparent" MouseLeftButtonUp="BtnMin_Click"
                                MouseEnter="BtnChromeBtn_MouseEnter" MouseLeave="BtnChromeBtn_MouseLeave">
                            <TextBlock Text="─" FontSize="11" Foreground="#60E8C881"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="BtnClose" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                Background="Transparent" MouseLeftButtonUp="BtnClose_Click"
                                MouseEnter="BtnCloseChromeBtn_MouseEnter" MouseLeave="BtnChromeBtn_MouseLeave">
                            <TextBlock Text="✕" FontSize="11" Foreground="#60E8C881"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Body: nav sinistra + contenuto ─────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nav -->
                <Border Grid.Column="0" CornerRadius="6" Background="#0C0C11"
                        BorderBrush="#20E8C881" BorderThickness="1" Padding="8,10" Margin="0,0,8,0">
                    <StackPanel>
                        <RadioButton x:Name="NavScripts"  Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="scripts"  Content="{DynamicResource NavScripts}"  Checked="Nav_Checked" IsChecked="True"/>
                        <RadioButton x:Name="NavNewTask"  Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="newtask"  Content="{DynamicResource NavNewTask}"  Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTasks"    Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="tasks"    Content="{DynamicResource NavTasks}"    Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavServices" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="services" Content="{DynamicResource NavServices}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWeb" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="web" Content="{DynamicResource NavWeb}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFunctions" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="functions" Content="{DynamicResource NavFunctions}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTestSuite" Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="testsuite" Content="{DynamicResource NavTestSuite}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLog"      Style="{StaticResource NavItem}" GroupName="nav"
                                     Tag="log"      Content="{DynamicResource NavLog}"      Checked="Nav_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Contenuto: una vista visibile alla volta -->
                <Grid Grid.Column="1">

                    <!-- Scripts: due sezioni distinte (SQL / PS1·BAT) -->
                    <GroupBox x:Name="PanelScripts" Header="{DynamicResource GbScripts}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnReloadScripts}" Click="BtnReloadScripts_Click"/>
                                <Button Content="{DynamicResource BtnOpenFolders}" Click="BtnOpenFolders_Click"/>
                                <Button Content="{DynamicResource BtnNewFile}" Click="BtnNewScript_Click"
                                        ToolTip="{DynamicResource TipNewFile}"/>
                                <TextBlock Text="{DynamicResource HintScripts}" Foreground="#35E8C881"
                                           FontSize="10" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- SQL -->
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#2252A8FF" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1152A8FF" CornerRadius="4,4,0,0" Padding="8,4">
                                        <TextBlock Text="🗄  DATABASE — SQL" Foreground="#52A8FF"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScriptsSqlList" ItemTemplate="{StaticResource ScriptRow}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- PS1 / BAT -->
                            <Border Grid.Row="3" CornerRadius="4" Background="#080810"
                                    BorderBrush="#225BD16A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#115BD16A" CornerRadius="4,4,0,0" Padding="8,4">
                                        <TextBlock Text="⚙  SISTEMA — PS1 / BAT" Foreground="#5BD16A"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScriptsPsList" ItemTemplate="{StaticResource ScriptRow}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- New task (form riutilizzabile, stesso del modale Pianifica) -->
                    <GroupBox x:Name="PanelNewTask" Header="{DynamicResource GbNewTask}" Visibility="Collapsed">
                        <controls:NewTaskControl x:Name="NewTaskCtrl"/>
                    </GroupBox>

                    <!-- Tasks -->
                    <GroupBox x:Name="PanelTasks" Header="{DynamicResource GbTasks}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnReloadTasks}" Click="BtnReloadTasks_Click"/>
                                <Button Content="{DynamicResource BtnOpenTaskSched}" Click="BtnOpenTaskSched_Click"
                                        ToolTip="{DynamicResource TipOpenTaskSched}"/>
                                <TextBlock x:Name="TbTaskStatus" VerticalAlignment="Center" Margin="12,0"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#18E8C881" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TasksList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#CCE0E0E0"
                                                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#7BE8C881"
                                                               FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Schedule}" Foreground="#66E0E0E0"
                                                               FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10"
                                                            Content="{DynamicResource BtnRunNow}" Click="BtnRunNowTask_Click"
                                                            ToolTip="{DynamicResource TipRunNowTask}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource MiniButton}" Foreground="#EEF0F0F0"
                                                            Background="{Binding LogBrush}" IsEnabled="{Binding HasLog}"
                                                            Content="{DynamicResource BtnTaskLog}" Click="BtnTaskLog_Click"
                                                            ToolTip="{Binding LogTip}"/>
                                                    <Button Grid.Column="5" Style="{StaticResource MiniButton}"
                                                            Content="{DynamicResource BtnEditTask}" Click="BtnEditTask_Click"
                                                            ToolTip="{DynamicResource TipEditTask}"/>
                                                    <Button Grid.Column="6" Style="{StaticResource MiniButton}"
                                                            Content="{DynamicResource BtnEnable}" Click="BtnEnableTask_Click"/>
                                                    <Button Grid.Column="7" Style="{StaticResource MiniButton}"
                                                            Content="{DynamicResource BtnDisable}" Click="BtnDisableTask_Click"/>
                                                    <Button Grid.Column="8" Style="{StaticResource DangerButton}"
                                                            Content="{DynamicResource BtnRemove}" Click="BtnRemoveTask_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Services -->
                    <GroupBox x:Name="PanelServices" Header="{DynamicResource GbServices}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="{DynamicResource BtnRefreshServices}" Click="BtnRefreshServices_Click"/>
                                <Button Content="{DynamicResource BtnStartServices}" Click="BtnStartServices_Click"/>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#18E8C881" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ServicesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#CCE0E0E0"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding StatusBrush}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10"
                                                                Content="{DynamicResource BtnStart}" Click="BtnStartService_Click"
                                                                Visibility="{Binding StartVis}"/>
                                                        <Button Style="{StaticResource DangerButton}"
                                                                Content="{DynamicResource BtnStop}" Click="BtnStopService_Click"
                                                                Visibility="{Binding StopVis}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Web server (XAMPP/Apache · IIS) -->
                    <GroupBox x:Name="PanelWeb" Header="{DynamicResource GbWeb}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0">
                                <Button Content="{DynamicResource BtnRefreshWeb}" Click="BtnRefreshWeb_Click"/>
                                <Button Content="{DynamicResource BtnRestartWeb}" Click="BtnRestartWeb_Click"/>
                                <Button Content="{DynamicResource BtnWebSslGen}" Click="BtnWebSslGen_Click"
                                        ToolTip="{DynamicResource TipWebSslGen}"/>
                                <Button Content="{DynamicResource BtnBackupWeb}" Click="BtnBackupWeb_Click"/>
                                <Button Content="{DynamicResource BtnOpenWebRoot}" Click="BtnOpenWebRoot_Click"/>
                                <Button Content="{DynamicResource BtnOpenWebLogs}" Click="BtnOpenWebLogs_Click"/>
                                <Button Style="{StaticResource AccentButton}"
                                        Content="{DynamicResource BtnWebSettings}" Click="BtnWebSettings_Click"/>
                            </WrapPanel>

                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#225BD16A" BorderThickness="1" Padding="10,7">
                                <StackPanel>
                                    <TextBlock x:Name="TbWebKind" Foreground="#7BE8C881" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TbWebHealth" Margin="0,3,0,0" FontFamily="Consolas" FontSize="11"
                                               Foreground="#AADDE0E0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TbWebCert" Margin="0,3,0,0" FontSize="10" Foreground="#66E0E0E0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="4" Background="#080810"
                                    BorderBrush="#18E8C881" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="WebServicesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="#CCE0E0E0"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding StatusBrush}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource AccentButton}" Padding="8,3" FontSize="10"
                                                                Content="{DynamicResource BtnStart}" Click="BtnStartService_Click"
                                                                Visibility="{Binding StartVis}"/>
                                                        <Button Style="{StaticResource DangerButton}"
                                                                Content="{DynamicResource BtnStop}" Click="BtnStopService_Click"
                                                                Visibility="{Binding StopVis}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Funzioni: contenitore a schede (una scheda per funzione) -->
                    <GroupBox x:Name="PanelFunctions" Header="{DynamicResource GbFunctions}" Visibility="Collapsed">
                        <TabControl x:Name="FunctionsTabs">
                            <!-- Scheda 1: PSM_Cmd-SecureCommandChannel (functions\psm_cmd-scc) -->
                            <TabItem Header="PSM_Cmd-SCC">
                                <controls:ScriptAreaControl x:Name="FuncArea">
                                    <controls:ScriptAreaControl.Actions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource AccentButton}"
                                                    Content="{DynamicResource BtnVerifyPsm}" Click="BtnVerifyPsmCmd_Click"/>
                                            <Button Content="{DynamicResource BtnInstallPsm}" Click="BtnInstallPsmCmd_Click"/>
                                            <Border Width="1" Background="#28E8C881" Margin="6,3"/>
                                            <Button Content="{DynamicResource BtnPsmSettings}" Click="BtnPsmCmdSettings_Click"/>
                                            <Button Content="{DynamicResource BtnPsmLog}" Click="BtnPsmCmdLog_Click"/>
                                        </StackPanel>
                                    </controls:ScriptAreaControl.Actions>
                                </controls:ScriptAreaControl>
                            </TabItem>
                            <!-- Scheda 2: Windows Firewall -->
                            <TabItem Header="🛡 Windows Firewall">
                                <controls:FirewallControl x:Name="FwArea"/>
                            </TabItem>
                            <!-- Nuove schede funzione: aggiungere qui un <TabItem> con la sua ScriptAreaControl. -->
                        </TabControl>
                    </GroupBox>

                    <!-- Test Suite -->
                    <GroupBox x:Name="PanelTestSuite" Header="{DynamicResource GbTestSuite}" Visibility="Collapsed">
                        <controls:ScriptAreaControl x:Name="TestArea">
                            <controls:ScriptAreaControl.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}"
                                            Content="{DynamicResource BtnRunTestSuite}" Click="BtnRunTestSuite_Click"/>
                                </StackPanel>
                            </controls:ScriptAreaControl.Actions>
                        </controls:ScriptAreaControl>
                    </GroupBox>

                    <!-- Log -->
                    <GroupBox x:Name="PanelLog" Header="{DynamicResource GbLog}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" x:Name="TbLog" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                     Background="#06060A" Foreground="#AADDE0E0" BorderThickness="0" Padding="6,6"/>
                            <Button Grid.Row="1" Content="{DynamicResource BtnClearLog}" HorizontalAlignment="Right"
                                    Click="BtnClearLog_Click" Margin="2,4,2,0"/>
                        </Grid>
                    </GroupBox>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
