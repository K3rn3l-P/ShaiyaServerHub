<Window x:Class="ShaiyaServerHub.NetworkAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test di rete" Icon="icon.ico"
        Width="900" Height="620" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Window.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCE0E0E0"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RiskCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="OK">
                    <Setter Property="Foreground" Value="#6BD98A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="ATTENZIONE">
                    <Setter Property="Foreground" Value="#E8C881"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="RISCHIO">
                    <Setter Property="Foreground" Value="#F46A6A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragWindow" HorizontalAlignment="Left">
                    <TextBlock Text="🔎" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource FwAuditHdr}" Foreground="#E8C881"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <!-- Riepilogo -->
            <Border Grid.Row="1" CornerRadius="4" Background="#080810" BorderBrush="#18E8C881" BorderThickness="1" Padding="10,7">
                <TextBlock x:Name="TbSummary" Foreground="#CCE0E0E0" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <DataGrid Grid.Row="2" x:Name="Grid" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource FwColPort}" Binding="{Binding Port}" Width="70" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource FwColProcess}" Binding="{Binding Process}" Width="120" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{DynamicResource FwColPurpose}" Binding="{Binding Purpose}" Width="*" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{DynamicResource FwColExposure}" Binding="{Binding Exposure}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{DynamicResource FwColRisk}" Binding="{Binding Risk}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource RiskCell}"/>
                    <DataGridTextColumn Header="{DynamicResource FwColNote}" Binding="{Binding Note}" Width="220" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="TbStatus" Foreground="#88E0E0E0" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource PsmRefresh}" Click="BtnReload_Click" MinWidth="90"/>
                    <Button Style="{StaticResource AccentButton}" Content="{DynamicResource BtnCloseWin}" Click="BtnClose_Click" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
