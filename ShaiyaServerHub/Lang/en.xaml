<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <s:String x:Key="AppSubtitle">Server automation &amp; control</s:String>

    <!-- Nav -->
    <s:String x:Key="NavScripts">📜  Scripts</s:String>
    <s:String x:Key="NavNewTask">＋  New task</s:String>
    <s:String x:Key="NavTasks">🕑  Scheduled</s:String>
    <s:String x:Key="NavServices">🖥  Services</s:String>
    <s:String x:Key="NavFunctions">🛠  Functions</s:String>
    <s:String x:Key="NavTestSuite">🛡  Test Suite</s:String>
    <s:String x:Key="NavLog">📋  Log</s:String>

    <!-- Functions / Test Suite -->
    <s:String x:Key="GbFunctions">FUNCTIONS</s:String>
    <s:String x:Key="GbTestSuite">SERVER TEST SUITE — SECURITY</s:String>
    <s:String x:Key="BtnVerifyPsm">✓ Verify PSM_Cmd</s:String>
    <s:String x:Key="BtnInstallPsm">⬇ Install / Repair PSM_Cmd</s:String>
    <s:String x:Key="BtnRunTestSuite">▶ Run all</s:String>
    <s:String x:Key="BtnOpenLog">📋 Log</s:String>
    <s:String x:Key="TipScriptLog">Open this script's log</s:String>
    <s:String x:Key="AreaLogTitle">LOG</s:String>
    <s:String x:Key="BtnCopy">Copy</s:String>
    <s:String x:Key="BtnCloseWin">Close</s:String>

    <!-- Scripts -->
    <s:String x:Key="GbScripts">SCRIPTS (sql\ + ps1\)</s:String>
    <s:String x:Key="HintScripts">Drop your .sql into "scripts\sql\" and .ps1/.bat into "scripts\ps1\" next to the exe. Loaded on each launch.</s:String>
    <s:String x:Key="BtnReloadScripts">↻ Reload</s:String>
    <s:String x:Key="BtnOpenFolders">📂 Open folders</s:String>
    <s:String x:Key="BtnRun">▶ Run</s:String>
    <s:String x:Key="BtnSchedule">🕑 Schedule</s:String>

    <!-- New task -->
    <s:String x:Key="GbNewTask">NEW SCHEDULED TASK</s:String>
    <s:String x:Key="HintNewTask">The task runs the script via the Hub in headless mode (centralized auth/log). Under SYSTEM account.</s:String>
    <s:String x:Key="LblSelScript">Script:</s:String>
    <s:String x:Key="LblTaskName">Task name:</s:String>
    <s:String x:Key="LblCadence">Cadence:</s:String>
    <s:String x:Key="LblEvery">Every (min/hrs):</s:String>
    <s:String x:Key="LblTime">Time (HH:mm):</s:String>
    <s:String x:Key="LblDays">Days:</s:String>
    <s:String x:Key="DayMon">Mon</s:String>
    <s:String x:Key="DayTue">Tue</s:String>
    <s:String x:Key="DayWed">Wed</s:String>
    <s:String x:Key="DayThu">Thu</s:String>
    <s:String x:Key="DayFri">Fri</s:String>
    <s:String x:Key="DaySat">Sat</s:String>
    <s:String x:Key="DaySun">Sun</s:String>
    <s:String x:Key="BtnCreateTask">＋ Create task</s:String>

    <!-- Tasks -->
    <s:String x:Key="GbTasks">SCHEDULED TASKS (\ShaiyaServerHub\)</s:String>
    <s:String x:Key="BtnReloadTasks">↻ Reload</s:String>
    <s:String x:Key="BtnEnable">Enable</s:String>
    <s:String x:Key="BtnDisable">Disable</s:String>
    <s:String x:Key="BtnRunNow">▶ Now</s:String>
    <s:String x:Key="TipRunNowTask">Run this task now (test)</s:String>
    <s:String x:Key="BtnRemove">✕ Remove</s:String>
    <s:String x:Key="BtnEditTask">✎ Edit</s:String>
    <s:String x:Key="TipEditTask">Edit this task</s:String>
    <s:String x:Key="BtnOpenTaskSched">🪟 Task Scheduler</s:String>
    <s:String x:Key="TipOpenTaskSched">Open Windows Task Scheduler</s:String>
    <s:String x:Key="LblProgram">Program/script:</s:String>
    <s:String x:Key="LblArguments">Arguments:</s:String>
    <s:String x:Key="LblStartIn">Start in:</s:String>

    <!-- Services -->
    <s:String x:Key="GbServices">SERVICES STATUS</s:String>
    <s:String x:Key="BtnRefreshServices">↻ Refresh</s:String>
    <s:String x:Key="BtnStartServices">▶ Start services</s:String>
    <s:String x:Key="BtnStart">▶ Start</s:String>
    <s:String x:Key="BtnStop">■ Stop</s:String>

    <!-- Log -->
    <s:String x:Key="GbLog">LOG</s:String>
    <s:String x:Key="BtnClearLog">Clear</s:String>

    <!-- Settings window -->
    <s:String x:Key="SetTitle">Settings</s:String>
    <s:String x:Key="SetGbSql">SQL CONNECTION</s:String>
    <s:String x:Key="LblServer">Server:</s:String>
    <s:String x:Key="LblAuth">Authentication:</s:String>
    <s:String x:Key="AuthWindows">Windows (-E)</s:String>
    <s:String x:Key="AuthSql">SQL login</s:String>
    <s:String x:Key="LblSqlUser">User:</s:String>
    <s:String x:Key="LblSqlPass">Password:</s:String>
    <s:String x:Key="LblDb">Database:</s:String>
    <s:String x:Key="BtnTestSql">Test connection</s:String>
    <s:String x:Key="SetGbPaths">PATHS</s:String>
    <s:String x:Key="LblBinPath">Server Bin folder:</s:String>
    <s:String x:Key="LblStartScript">Start-services script:</s:String>
    <s:String x:Key="BtnBrowse">Browse</s:String>
    <s:String x:Key="SetGbChannel">COMMAND CHANNEL (PSM_Cmd)</s:String>
    <s:String x:Key="HintChannel">Under Windows auth (sysadmin) scripts using usp_RunCommand (/mmake, /exp2xenable) are denied (-3): sysadmin is not in GmCallerProfile. Register the current login with ECONOMY tier to make them work.</s:String>
    <s:String x:Key="BtnRegisterCaller">Enable this login in the command channel (ECONOMY)</s:String>
    <s:String x:Key="BtnSave">Save</s:String>
    <s:String x:Key="BtnCancel">Cancel</s:String>

</ResourceDictionary>
