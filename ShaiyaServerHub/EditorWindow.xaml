<Window x:Class="ShaiyaServerHub.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor" Icon="icon.ico"
        Width="900" Height="640" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragWindow" HorizontalAlignment="Left">
                    <TextBlock Text="✎" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TbTitle" Text="Editor" Foreground="#E8C881"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="BadgeKind" CornerRadius="3" Background="#22E8C881"
                            Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TbKind" Text="" Foreground="#E8C881" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TbDirty" Text="" Foreground="#F4A24D" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <!-- Editor body -->
            <Border Grid.Row="1" CornerRadius="4" Background="#06060A" BorderBrush="#18E8C881" BorderThickness="1">
                <TextBox x:Name="TbEditor"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="13"
                         Background="Transparent" Foreground="#DDE0E0E0" BorderThickness="0" Padding="8,6"
                         VerticalContentAlignment="Top"
                         TextChanged="TbEditor_TextChanged"/>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="TbPath" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#55E0E0E0" FontFamily="Consolas" FontSize="10"
                           TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TbStatus" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontSize="11" FontWeight="SemiBold"/>
                    <Button Content="{DynamicResource BtnCancel}" Click="BtnCancel_Click" MinWidth="90"/>
                    <Button Style="{StaticResource AccentButton}" Content="{DynamicResource BtnSaveFile}"
                            Click="BtnSave_Click" MinWidth="120"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
