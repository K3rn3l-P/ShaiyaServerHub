<Window x:Class="ShaiyaServerHub.FirewallRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova regola firewall" Icon="icon.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel Margin="14">
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="TbHeader" Text="{DynamicResource FwDlgTitle}" Foreground="#E8C881"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MouseLeftButtonDown="DragWindow"/>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnCancel_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource FwDlgName}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbName"/>

                <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource FwDlgProto}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbProto">
                    <ComboBoxItem Content="TCP" IsSelected="True"/>
                    <ComboBoxItem Content="UDP"/>
                </ComboBox>

                <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource FwDlgPort}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbPort" ToolTip="{DynamicResource FwDlgPortTip}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource FwDlgAction}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CbAction">
                    <ComboBoxItem Content="Allow" IsSelected="True"/>
                    <ComboBoxItem Content="Block"/>
                </ComboBox>

                <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource FwDlgScope}"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CbScope" SelectionChanged="CbScope_Changed">
                    <ComboBoxItem Content="{DynamicResource FwDlgScopeAny}" Tag="Any" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource FwDlgScopeLan}" Tag="LAN"/>
                    <ComboBoxItem Content="{DynamicResource FwDlgScopeCustom}" Tag="CUSTOM"/>
                </ComboBox>

                <Label Grid.Row="5" Grid.Column="0" x:Name="LblCustom" Content="{DynamicResource FwDlgCustom}" Visibility="Collapsed"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TbCustomScope" Visibility="Collapsed"
                         ToolTip="{DynamicResource FwDlgCustomTip}"/>
            </Grid>

            <TextBlock x:Name="TbErr" Foreground="#F46A6A" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{DynamicResource BtnCancel}" Click="BtnCancel_Click" MinWidth="90"/>
                <Button x:Name="BtnOk" Style="{StaticResource AccentButton}" Content="{DynamicResource FwDlgAdd}" Click="BtnOk_Click" MinWidth="110"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
