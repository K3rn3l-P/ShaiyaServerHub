<Window x:Class="ShaiyaServerHub.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log" Icon="icon.ico"
        Width="820" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragWindow" HorizontalAlignment="Left">
                    <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TbTitle" Text="Log" Foreground="#E8C881"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <!-- Log body -->
            <Border Grid.Row="1" CornerRadius="4" Background="#06060A" BorderBrush="#18E8C881" BorderThickness="1">
                <TextBox x:Name="TbLog" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                         Background="Transparent" Foreground="#AADDE0E0" BorderThickness="0" Padding="8,6"/>
            </Border>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{DynamicResource BtnCopy}" Click="BtnCopy_Click" MinWidth="90"/>
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource BtnCloseWin}"
                        Click="BtnClose2_Click" MinWidth="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
