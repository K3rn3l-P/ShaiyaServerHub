<Window x:Class="ShaiyaServerHub.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guida" Icon="icon.ico"
        Width="760" Height="660" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Window.Resources>
        <Style x:Key="SectionHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8C881"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAE0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SnippetBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="#06060A"/>
            <Setter Property="Foreground" Value="#AAD8E0C8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragWindow" HorizontalAlignment="Left">
                    <TextBlock Text="❓" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource GuideTitle}" Foreground="#E8C881"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideIntro}"/>

                    <!-- 1) Riavvio / spegnimento -->
                    <TextBlock Style="{StaticResource SectionHdr}" Text="{DynamicResource GuideShutdownHdr}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideShutdownDesc}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource SnippetBox}"
                                 Text="Programma:  shutdown&#x0a;Argomenti:  /r /f /t 0    (riavvio)&#x0a;Argomenti:  /s /f /t 0    (spegnimento)"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Content="/r /f /t 0" Click="CopyRestart_Click"/>
                            <Button Content="/s /f /t 0" Click="CopyStop_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2) Trigger su evento -->
                    <TextBlock Style="{StaticResource SectionHdr}" Text="{DynamicResource GuideEventHdr}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideEventDesc}"/>
                    <TextBox Style="{StaticResource SnippetBox}" Margin="0,4,0,0" MinHeight="70"
                             VerticalScrollBarVisibility="Auto" x:Name="TbEventExample"/>

                    <!-- 3) Come funziona il generatore -->
                    <TextBlock Style="{StaticResource SectionHdr}" Text="{DynamicResource GuideGenHowHdr}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideGenStep1}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideGenStep2}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideGenStep3}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideGenStep4}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideGenStateNote}"
                               Foreground="#E8B24D" Margin="0,4,0,0"/>

                    <!-- 4) Trovare EventID a mano -->
                    <TextBlock Style="{StaticResource SectionHdr}" Text="{DynamicResource GuideFindHdr}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource GuideFindDesc}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TbFindCmd" Style="{StaticResource SnippetBox}" MinHeight="44"
                                 Text="Get-WinEvent -FilterHashtable @{LogName='System';ProviderName='Service Control Manager';Id=7036} -MaxEvents 20 | Format-List TimeCreated, Message"/>
                        <Button Grid.Column="1" Content="{DynamicResource BtnCopy}" Click="CopyFindCmd_Click" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock x:Name="TbStatus" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="11" FontWeight="SemiBold" Foreground="#4DC870"/>
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource BtnCloseWin}"
                        Click="BtnClose2_Click" MinWidth="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
