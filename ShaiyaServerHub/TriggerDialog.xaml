<Window x:Class="ShaiyaServerHub.TriggerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShaiyaServerHub.Controls"
        Title="Trigger" Icon="icon.ico"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" Foreground="#E0E0E0" FontSize="12">

    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel Margin="14">
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragWindow" HorizontalAlignment="Left">
                    <TextBlock Text="🕑" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TbHeader" Text="{DynamicResource TrigDlgTitle}" Foreground="#E8C881"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="10,3" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="12" Foreground="#60E8C881" IsHitTestVisible="False"/>
                </Border>
            </Grid>

            <controls:CadencePicker x:Name="Picker"/>

            <TextBlock x:Name="TbError" Foreground="#F46A6A" FontSize="11" Margin="4,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{DynamicResource BtnCancel}" Click="BtnCancel_Click" MinWidth="90"/>
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource TrigDlgAdd}"
                        Click="BtnOk_Click" MinWidth="120"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
