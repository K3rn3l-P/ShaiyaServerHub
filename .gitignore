# ── Build output ──────────────────────────────────────
bin/
obj/
[Bb]in/
[Oo]bj/

# ── Visual Studio ─────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# ── Runtime (generati accanto all'exe, mai nel repo) ──
# hub.settings.xml contiene la password SQL cifrata DPAPI → mai nel repo
hub.settings.xml
hub.log
hub-tasks.log

# ── Segreti (password reali) → MAI nel repo ───────────
.env
*.env

# ── Cartelle script generate a RUNTIME se l'exe gira dalla dir del progetto ─
# I DEFAULT versionati stanno in ShaiyaServerHub/DefaultScripts/ (quelli SÌ nel repo);
# queste invece sono copie di lavoro locali, da ignorare.
/ShaiyaServerHub/scripts/
/ShaiyaServerHub/functions/
/ShaiyaServerHub/testsuite/

# ── Varie ─────────────────────────────────────────────
*.tmp
Thumbs.db
desktop.ini

# ── Syncthing (il repo è in una share sync) ───────────
*.sync-conflict-*
.stfolder
.stversions
